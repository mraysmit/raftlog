<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${RAFTLOG_LOG_DIR:-${user.dir}/logs}"/>
    <property name="INSTANCE_ID" value="${RAFTLOG_INSTANCE_ID:-${HOSTNAME:-local}}"/>
    <timestamp key="runLocalTimestamp" datePattern="yyyy-MM-dd_HH-mm-ss" timeReference="contextBirth"/>
    <property name="LOG_BASE" value="${LOG_DIR}/raftlog-demo-${INSTANCE_ID}-${runLocalTimestamp}"/>
    <property name="RAFTLOG_LEVEL" value="${RAFTLOG_LOG_LEVEL:-INFO}"/>
    
    <!-- Console appender for Docker logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36}%replace( [%X{storageId}]){' \[\]', ''}%replace( [%X{operationId}]){' \[\]', ''}%replace( [%X{agentId}]){' \[\]', ''}%replace( [%X{requestId}]){' \[\]', ''} %kvp - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File appender for persistent logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- One file per run, named for when the run started; a run that outgrows it rolls to .1, .2 ... beside it -->
        <file>${LOG_BASE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_BASE}.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>9</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>100MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36}%replace( [%X{storageId}]){' \[\]', ''}%replace( [%X{operationId}]){' \[\]', ''}%replace( [%X{agentId}]){' \[\]', ''}%replace( [%X{requestId}]){' \[\]', ''} %kvp - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- JSON appender for structured logging -->
    <appender name="JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_BASE}.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_BASE}.%i.json</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>9</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>100MB</maxFileSize>
        </triggeringPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <message/>
                <mdc/>
                <keyValuePairs/>
                <arguments/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>
    
    <!-- Logger configurations -->
    <logger name="dev.mars.raftlog" level="${RAFTLOG_LEVEL}"/>
    <logger name="org.apache.hc" level="WARN"/>
    <logger name="com.sun.net.httpserver" level="WARN"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="JSON"/>
    </root>
</configuration>
